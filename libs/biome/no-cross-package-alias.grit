engine biome(1.0)
language js(typescript,jsx)

or {
  `import $_ from $source` where {
    not $filename <: r".*libs[/\\]ui[/\\].*",
    $source <: or { `"@ui"`, includes "@ui/" },
    register_diagnostic(
      span = $source,
      message = "Use @diskpond/ui instead of @ui. Path aliases are only for same-package imports."
    )
  },
  `import $_ from $source` where {
    not $filename <: r".*libs[/\\]styles[/\\].*",
    $source <: or { `"@styles"`, includes "@styles/" },
    register_diagnostic(
      span = $source,
      message = "Use @diskpond/styles instead of @styles. Path aliases are only for same-package imports."
    )
  },
  `import $_ from $source` where {
    not $filename <: r".*libs[/\\]utils[/\\].*",
    $source <: or { `"@utils"`, includes "@utils/" },
    register_diagnostic(
      span = $source,
      message = "Use @diskpond/utils instead of @utils. Path aliases are only for same-package imports."
    )
  },
  `import $_ from $source` where {
    not $filename <: r".*apps[/\\]desktop[/\\].*",
    $source <: or { `"@desktop"`, includes "@desktop/" },
    register_diagnostic(
      span = $source,
      message = "Use @diskpond/desktop instead of @desktop. Path aliases are only for same-package imports."
    )
  },
  `import $_ from $source` where {
    not $filename <: r".*libs[/\\]hooks[/\\].*",
    $source <: or { `"@hooks"`, includes "@hooks/" },
    register_diagnostic(
      span = $source,
      message = "Use @diskpond/hooks instead of @hooks. Path aliases are only for same-package imports."
    )
  },
  `import $_ from $source` where {
    not $filename <: r".*libs[/\\]schemas[/\\].*",
    $source <: or { `"@schemas"`, includes "@schemas/" },
    register_diagnostic(
      span = $source,
      message = "Use @diskpond/schemas instead of @schemas. Path aliases are only for same-package imports."
    )
  },
  `import $_ from $source` where {
    not $filename <: r".*libs[/\\]forms[/\\].*",
    $source <: or { `"@forms"`, includes "@forms/" },
    register_diagnostic(
      span = $source,
      message = "Use @diskpond/forms instead of @forms. Path aliases are only for same-package imports."
    )
  },
  `import $_ from $source` where {
    not $filename <: r".*apps[/\\]electron[/\\].*",
    $source <: or { `"@electron"`, includes "@electron/" },
    register_diagnostic(
      span = $source,
      message = "Use @diskpond/electron instead of @electron. Path aliases are only for same-package imports."
    )
  }
}
