{
  "name": "@diskpond/electron",
  "description": "DiskPond desktop backup application.",
  "repository": "https://github.com/hoxsec/DiskPond",
  "author": {
    "name": "DiskPond contributors"
  },
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "main": "./build/index.js",
  "scripts": {
    "dev": "concurrently \"pnpm:compile:dev\" \"pnpm:dev:electron\"",
    "dev:electron": "electronmon ./build/index.js",
    "types": "tsc --noEmit",
    "test": "vitest run",
    "compile:dev": "node esbuild.config.mjs development",
    "compile:once": "node esbuild.config.mjs development once",
    "compile:prod": "node esbuild.config.mjs production",
    "prebuild": "pnpm build:frontend && tsc --noEmit && pnpm compile:prod",
    "build:frontend": "pnpm --filter @diskpond/desktop build && node ../../scripts/copy-frontend.mjs",
    "build:linux": "electron-builder -c electron.builder.ts --linux",
    "build:windows": "electron-builder -c electron.builder.ts --windows",
    "build:macos": "electron-builder -c electron.builder.ts --macos"
  },
  "dependencies": {
    "@blinkdisk/signaldb-electron": "catalog:",
    "@diskpond/constants": "workspace:*",
    "@diskpond/schemas": "workspace:*",
    "@diskpond/utils": "workspace:*",
    "@esbuild-plugins/tsconfig-paths": "catalog:",
    "@signaldb/core": "catalog:",
    "@signaldb/fs": "catalog:",
    "auto-launch": "catalog:",
    "aws4": "1.13.2",
    "electron-log": "catalog:",
    "electron-store": "catalog:",
    "electron-updater": "catalog:",
    "get-folder-size": "catalog:",
    "semver": "7.8.5",
    "ssh2": "1.17.0",
    "tough-cookie": "catalog:",
    "yaml": "2.9.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@diskpond/typescript": "workspace:*",
    "@types/auto-launch": "catalog:",
    "@types/aws4": "1.11.6",
    "@types/node": "catalog:",
    "@types/semver": "^7.8.0",
    "@types/ssh2": "1.15.5",
    "concurrently": "catalog:",
    "dotenv": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electronmon": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  }
}
