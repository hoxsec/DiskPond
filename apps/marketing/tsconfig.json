{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "site/**/*", "astro.config.ts"],
  "exclude": ["dist", "src", "sentry.*.config.ts"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["./src/*"],
      "@marketing/*": ["./src/*"],
      "@ui/*": ["../../libs/ui/src/*"],
      "@utils/*": ["../../libs/utils/src/*"],
      "@hooks/*": ["../../libs/hooks/src/*"],
      "@styles/*": ["../../libs/styles/*"],
      "@config/*": ["../../libs/config/src/*"],
      "@forms/*": ["../../libs/forms/src/*"],
    },
  },
}
