---
import AppleIcon from "@lucide/astro/icons/apple";
import ArrowRightIcon from "@lucide/astro/icons/arrow-right";
import DownloadIcon from "@lucide/astro/icons/download";
import MonitorIcon from "@lucide/astro/icons/monitor";
import TerminalIcon from "@lucide/astro/icons/terminal";
import { site } from "../config";
import { copy } from "../content";
import SiteLayout from "../layouts/site-layout.astro";
---
<SiteLayout title={copy.download.meta}>
  <section class="page-heading container"><p class="eyebrow">{copy.download.eyebrow}</p><h1>{copy.download.title}</h1><p>{copy.download.description}</p></section>
  <section class="container download-grid">
    <article class="download-card windows-card"><div class="plan-top"><MonitorIcon aria-hidden="true" /><span class="badge">{copy.download.latest}</span></div><h2>{copy.download.windows}</h2><p>{copy.download.requirements}</p><a class="button" href={site.download}><DownloadIcon aria-hidden="true" />{copy.download.installer}</a><a class="text-link" href={site.releases}>{copy.download.releaseNotes} ↗</a><p class="small">{copy.download.unsigned} <a href={`${site.repository}/blob/main/docs/windows-release.txt`}>{copy.download.installation} ↗</a></p></article>
    {[{ title: copy.download.mac, Icon: AppleIcon }, { title: copy.download.linux, Icon: TerminalIcon }].map(({ title, Icon }) => <article class="download-card planned-card"><div class="plan-top"><Icon aria-hidden="true" /><span class="badge badge-neutral">{copy.download.planned}</span></div><h2>{title}</h2><p>{copy.download.plannedBody}</p><a class="text-link" href={site.releases}>{copy.download.releases} ↗</a></article>)}
  </section>
  <section class="section container"><div class="section-heading centered"><h2>{copy.download.nextTitle}</h2></div><div class="three-columns step-grid">{copy.download.steps.map((step, index) => <article><span class="step-number">0{index + 1}</span><h3>{step.title}</h3><p>{step.body}</p></article>)}</div><a class="text-link centered-link" href="/guides/first-backup">{copy.home.steps.link}<ArrowRightIcon aria-hidden="true" /></a></section>
</SiteLayout>
