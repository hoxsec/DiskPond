---
import { site } from "../config";
import { copy } from "../content";
import SiteLayout from "../layouts/site-layout.astro";
export function getStaticPaths() {
  return ["privacy", "terms"].map((legal) => ({ params: { legal } }));
}
const content =
  Astro.params.legal === "terms" ? copy.legal.terms : copy.legal.privacy;
---
<SiteLayout title={content.title} description={content.intro}>
  <article class="article-page container">
    <header><p class="eyebrow">{copy.legal.updated}</p><h1>{content.title}</h1><p class="article-intro">{content.intro}</p></header>
    <div class="article-body">{content.sections.map((section) => <section><h2>{section.title}</h2><p>{section.body}</p></section>)}<p><a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a> · <a href={site.repository}>{copy.footer.source}</a></p></div>
  </article>
</SiteLayout>
