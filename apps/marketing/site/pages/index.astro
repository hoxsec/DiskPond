---
import ArrowRightIcon from "@lucide/astro/icons/arrow-right";
import ArrowUpRightIcon from "@lucide/astro/icons/arrow-up-right";
import CalendarDaysIcon from "@lucide/astro/icons/calendar-days";
import CheckIcon from "@lucide/astro/icons/check";
import Clock3Icon from "@lucide/astro/icons/clock-3";
import CloudIcon from "@lucide/astro/icons/cloud";
import CodeXmlIcon from "@lucide/astro/icons/code-xml";
import DownloadIcon from "@lucide/astro/icons/download";
import FilesIcon from "@lucide/astro/icons/files";
import FolderIcon from "@lucide/astro/icons/folder";
import GitCompareArrowsIcon from "@lucide/astro/icons/git-compare-arrows";
import HardDriveIcon from "@lucide/astro/icons/hard-drive";
import LockKeyholeIcon from "@lucide/astro/icons/lock-keyhole";
import NetworkIcon from "@lucide/astro/icons/network";
import RotateCcwIcon from "@lucide/astro/icons/rotate-ccw";
import AppScreenshot from "../components/app-screenshot.astro";
import Cta from "../components/cta.astro";
import Faq from "../components/faq.astro";
import ProductGallery from "../components/product-gallery.astro";
import ScreenshotDialog from "../components/screenshot-dialog.astro";
import { site } from "../config";
import { copy } from "../content";
import SiteLayout from "../layouts/site-layout.astro";

const features = [
  LockKeyholeIcon,
  FilesIcon,
  Clock3Icon,
  GitCompareArrowsIcon,
  RotateCcwIcon,
  CalendarDaysIcon,
];
const reasons = [RotateCcwIcon, HardDriveIcon, FolderIcon];
const storageIcons = [HardDriveIcon, CloudIcon, NetworkIcon];
const storageScreenshots = ["local", "cloud", "remote"] as const;
---

<SiteLayout>
  <section class="hero-section">
    <div class="hero-pattern" aria-hidden="true"></div>
    <div class="container hero-content">
      <a class="announcement" href="/cloud"><CloudIcon aria-hidden="true" /><span>{copy.home.announcement}</span><ArrowRightIcon aria-hidden="true" /></a>
      <p class="eyebrow">{copy.home.eyebrow}</p>
      <h1>{copy.home.title}<br /><span class="accent-text">{copy.home.titleAccent}</span></h1>
      <p class="hero-description">{copy.home.description}</p>
      <div class="actions centered"><a class="button" href="/download"><DownloadIcon aria-hidden="true" />{copy.common.windowsDownload}</a><a class="button button-secondary" href="/cloud">{copy.common.exploreCloud}<ArrowUpRightIcon aria-hidden="true" /></a></div>
      <p class="hero-platform">{copy.home.platform}</p>
      <ul class="trust-list">{copy.home.trust.map((item) => <li><CheckIcon aria-hidden="true" />{item}</li>)}</ul>
    </div>
    <ProductGallery />
  </section>

  <section class="section container">
    <div class="section-heading centered"><p class="eyebrow">{copy.home.why.eyebrow}</p><h2>{copy.home.why.title}</h2><p>{copy.home.why.description}</p></div>
    <div class="three-columns reason-grid">{copy.home.why.items.map((item, index) => {
      const Icon = reasons[index] ?? RotateCcwIcon;
      return <article><span class="icon-box"><Icon aria-hidden="true" /></span><h3>{item.title}</h3><p>{item.body}</p></article>;
    })}</div>
  </section>

  <section class="section surface-section" id="features">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">{copy.home.features.eyebrow}</p><h2>{copy.home.features.title}</h2><p>{copy.home.features.description}</p></div>
      <div class="feature-grid">{copy.home.features.items.map((item, index) => {
        const Icon = features[index] ?? LockKeyholeIcon;
        return <article class:list={["feature-card", { "feature-wide": index < 2 }]}>
          <span class="icon-box"><Icon aria-hidden="true" /></span>
          <h3>{item.title}</h3><p>{item.body}</p>
          {index < 2 && <div class="feature-art" aria-hidden="true"><div class="file-stack"><FolderIcon /><FolderIcon /><FolderIcon /></div><span class="connector"></span><span class="feature-art-destination"><Icon /></span></div>}
          {"detail" in item && <p class="feature-detail">{item.detail}</p>}
        </article>;
      })}</div>
    </div>
  </section>

  <section class="section container product-stories" aria-label={copy.home.showcase.label}>
    <article class="product-story">
      <div class="story-copy"><p class="eyebrow">{copy.home.showcase.schedule.eyebrow}</p><h2>{copy.home.showcase.schedule.title}</h2><p>{copy.home.showcase.schedule.body}</p><ul class="check-list">{copy.home.showcase.schedule.points.map(point => <li><CheckIcon aria-hidden="true" />{point}</li>)}</ul><a class="text-link" href="/guides/first-backup">{copy.home.steps.link}<ArrowRightIcon aria-hidden="true" /></a></div>
      <AppScreenshot name="policies" alt={copy.home.showcase.schedule.alt} />
    </article>
    <article class="product-story story-reverse">
      <div class="story-copy"><p class="eyebrow">{copy.home.showcase.restore.eyebrow}</p><h2>{copy.home.showcase.restore.title}</h2><p>{copy.home.showcase.restore.body}</p><div class="restore-preview"><AppScreenshot name="restore" alt={copy.home.showcase.restore.dialogAlt} sizes="(max-width: 760px) 92vw, 320px" /></div><a class="text-link" href="/guides/restore-files">{copy.home.showcase.restore.link}<ArrowRightIcon aria-hidden="true" /></a></div>
      <AppScreenshot name="browser" alt={copy.home.showcase.restore.alt} />
    </article>
  </section>

  <section class="section container">
    <div class="section-heading centered"><p class="eyebrow">{copy.home.steps.eyebrow}</p><h2>{copy.home.steps.title}</h2></div>
    <div class="three-columns step-grid">{copy.home.steps.items.map((item, index) => <article><span class="step-number">0{index + 1}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div>
    <a class="text-link centered-link" href="/guides/first-backup">{copy.home.steps.link}<ArrowRightIcon aria-hidden="true" /></a>
  </section>

  <section class="section surface-section" id="storage">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">{copy.home.storage.eyebrow}</p><h2>{copy.home.storage.title}</h2><p>{copy.home.storage.description}</p></div>
      <div class="three-columns storage-grid">{copy.home.storage.groups.map((group, index) => {
        const Icon = storageIcons[index] ?? HardDriveIcon;
        return <article><Icon class="storage-icon" aria-hidden="true" /><h3>{group.title}</h3><AppScreenshot name={storageScreenshots[index] ?? "local"} alt={group.alt} sizes="(max-width: 760px) 92vw, 360px" /><ul>{group.items.map((item) => <li><CheckIcon aria-hidden="true" />{item}</li>)}</ul></article>;
      })}</div>
      <p class="small storage-note">{copy.home.storage.note}</p>
      <div class="cloud-callout"><CloudIcon aria-hidden="true" /><div><h3>{copy.home.storage.cloudTitle}</h3><p>{copy.home.storage.cloudBody}</p></div><a class="text-link" href="/cloud">{copy.common.exploreCloud}<ArrowUpRightIcon aria-hidden="true" /></a></div>
    </div>
  </section>

  <section class="section container open-source-section">
    <div class="open-source-art" aria-hidden="true"><CodeXmlIcon /><span>AGPL-3.0</span></div>
    <div class="section-heading"><p class="eyebrow">{copy.home.open.eyebrow}</p><h2>{copy.home.open.title}</h2><p>{copy.home.open.description}</p><ul class="check-list">{copy.home.open.points.map((point) => <li><CheckIcon aria-hidden="true" />{point}</li>)}</ul><a class="button button-secondary" href={site.repository}>{copy.common.github}<ArrowUpRightIcon aria-hidden="true" /></a></div>
  </section>
  <Faq />
  <Cta />
  <ScreenshotDialog />
</SiteLayout>
