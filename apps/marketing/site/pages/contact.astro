---
import ArrowUpRightIcon from "@lucide/astro/icons/arrow-up-right";
import CodeXmlIcon from "@lucide/astro/icons/code-xml";
import HeadphonesIcon from "@lucide/astro/icons/headphones";
import MailIcon from "@lucide/astro/icons/mail";
import { site } from "../config";
import { copy } from "../content";
import SiteLayout from "../layouts/site-layout.astro";
---
<SiteLayout title={copy.contact.meta}>
  <section class="page-heading container"><p class="eyebrow">{copy.contact.eyebrow}</p><h1>{copy.contact.title}</h1><p>{copy.contact.description}</p></section>
  <section class="container contact-grid">
    <div class="contact-options">
      <article><span class="icon-box"><MailIcon aria-hidden="true" /></span><h2>{copy.contact.sales}</h2><p>{copy.contact.salesBody}</p><a class="text-link" href={`mailto:${site.salesEmail}`}>{site.salesEmail}<ArrowUpRightIcon aria-hidden="true" /></a></article>
      <article><span class="icon-box"><HeadphonesIcon aria-hidden="true" /></span><h2>{copy.contact.support}</h2><p>{copy.contact.supportBody}</p><a class="text-link" href={`mailto:${site.supportEmail}`}>{site.supportEmail}<ArrowUpRightIcon aria-hidden="true" /></a></article>
      <article><span class="icon-box"><CodeXmlIcon aria-hidden="true" /></span><h2>{copy.contact.source}</h2><p>{copy.contact.sourceBody}</p><a class="text-link" href={`${site.repository}/issues`}>{copy.contact.issue}<ArrowUpRightIcon aria-hidden="true" /></a></article>
    </div>
    <form class="contact-form" id="contact-form" hidden>
      <h2>{copy.contact.formTitle}</h2><p id="form-note">{copy.contact.formNote}</p>
      <div class="form-row"><label for="contact-name">{copy.contact.name}<input id="contact-name" name="name" autocomplete="name" required maxlength="100" /></label><label for="contact-email">{copy.contact.email}<input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254" /></label></div>
      <label for="contact-topic">{copy.contact.topic}<select id="contact-topic" name="topic">{copy.contact.topics.map((topic, index) => <option value={index}>{topic}</option>)}</select></label>
      <label for="contact-message">{copy.contact.message}<textarea id="contact-message" name="message" rows="6" required maxlength="1500" aria-describedby="contact-privacy"></textarea></label>
      <p class="small" id="contact-privacy">{copy.contact.privacy}</p>
      <button class="button" type="submit" aria-describedby="form-note">{copy.contact.submit}<ArrowUpRightIcon aria-hidden="true" /></button>
      <p class="form-status" role="status" id="contact-status"></p>
    </form>
  </section>
</SiteLayout>

<script>
  import { emailLink, site } from "../config";
  import { copy } from "../content";
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  if (form) form.hidden = false;
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    const topicIndex = Number(data.get("topic"));
    const topic = copy.contact.topics[topicIndex] ?? copy.contact.topics[0];
    const recipient = topicIndex === 2 ? site.supportEmail : site.salesEmail;
    const body = `${copy.contact.from}: ${data.get("name")} <${data.get("email")}>\n\n${data.get("message")}`;
    const status = document.querySelector("#contact-status");
    window.location.href = emailLink(recipient, `${copy.contact.subject} — ${topic}`, body);
    if (status) status.textContent = copy.contact.status;
  });
</script>
