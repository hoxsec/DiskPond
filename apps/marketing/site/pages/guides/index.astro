---
import ArrowUpRightIcon from "@lucide/astro/icons/arrow-up-right";
import CopyIcon from "@lucide/astro/icons/copy";
import FolderPlusIcon from "@lucide/astro/icons/folder-plus";
import RotateCcwIcon from "@lucide/astro/icons/rotate-ccw";
import Cta from "../../components/cta.astro";
import { copy } from "../../content";
import SiteLayout from "../../layouts/site-layout.astro";

const icons = [FolderPlusIcon, RotateCcwIcon, CopyIcon];
---
<SiteLayout title={copy.guides.meta} description={copy.guides.description}>
  <section class="page-heading container"><p class="eyebrow">{copy.guides.eyebrow}</p><h1>{copy.guides.title}</h1><p>{copy.guides.description}</p></section>
  <div class="container three-columns guide-grid">{copy.guides.items.map((guide, index) => { const Icon = icons[index] ?? FolderPlusIcon; return <article class="guide-card"><a class="guide-art" tabindex="-1" aria-hidden="true" href={`/guides/${guide.slug}`}><Icon /></a><div class="guide-card-body"><p class="eyebrow">{guide.category} <span>· {guide.time}</span></p><h2><a href={`/guides/${guide.slug}`}>{guide.title}</a></h2><p>{guide.description}</p><a class="text-link" href={`/guides/${guide.slug}`}>{copy.guides.read}<ArrowUpRightIcon aria-hidden="true" /></a></div></article>; })}</div>
  <Cta />
</SiteLayout>
