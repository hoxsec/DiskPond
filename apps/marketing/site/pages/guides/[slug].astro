---
import ArrowLeftIcon from "@lucide/astro/icons/arrow-left";
import Cta from "../../components/cta.astro";
import { copy } from "../../content";
import SiteLayout from "../../layouts/site-layout.astro";
export function getStaticPaths() {
  return copy.guides.items.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}
interface Props {
  guide: (typeof copy.guides.items)[number];
}
const { guide } = Astro.props;
---
<SiteLayout title={guide.title} description={guide.description}>
  <article class="article-page container">
    <a class="text-link" href="/guides"><ArrowLeftIcon aria-hidden="true" />{copy.guides.back}</a>
    <header><p class="eyebrow">{guide.category} · {guide.time}</p><h1>{guide.title}</h1><p class="article-intro">{guide.description}</p></header>
    <div class="article-body">{guide.sections.map((section) => <section><h2>{section.title}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</section>)}</div>
  </article>
  <Cta />
</SiteLayout>
