---
import icon from "@blinkdisk/assets/brand/diskpond-icon.svg?url";
import Footer from "../components/footer.astro";
import Navigation from "../components/navigation.astro";
import { site } from "../config";
import { copy } from "../content";
import "../styles.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = copy.meta.description,
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} | DiskPond` : copy.meta.title;
const canonical = new URL(
  Astro.url.pathname.replace(/\/$/, "") || "/",
  site.url,
);
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "DiskPond",
  url: site.url,
  description: copy.meta.description,
}).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={icon} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DiskPond" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/social.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.meta.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={structuredData} />
    <script is:inline>
      (() => {
        let theme = "system";
        try { theme = localStorage.getItem("diskpond.site.theme") || "system"; } catch {}
        document.documentElement.classList.toggle("dark", theme === "dark" || (theme !== "light" && matchMedia("(prefers-color-scheme: dark)").matches));
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{copy.common.skip}</a>
    <Navigation />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
