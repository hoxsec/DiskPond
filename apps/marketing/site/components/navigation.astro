---
import logo from "@blinkdisk/assets/brand/diskpond-logo.svg?url";
import darkLogo from "@blinkdisk/assets/brand/diskpond-logo-dark.svg?url";
import ArrowUpRightIcon from "@lucide/astro/icons/arrow-up-right";
import MenuIcon from "@lucide/astro/icons/menu";
import { copy } from "../content";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={copy.common.home}>
      <img class="logo-light" src={logo} width="709" height="232" alt="DiskPond" />
      <img class="logo-dark" src={darkLogo} width="709" height="232" alt="DiskPond" />
    </a>
    <nav class="desktop-nav" aria-label={copy.nav.label}>
      {copy.nav.links.map((link) => (
        <a href={link.href} aria-current={pathname === link.href ? "page" : undefined}>{link.label}</a>
      ))}
    </nav>
    <a class="button button-small header-download" href="/download">{copy.common.download}<ArrowUpRightIcon aria-hidden="true" /></a>
    <details class="mobile-menu">
      <summary aria-label={copy.nav.menu}><MenuIcon aria-hidden="true" /></summary>
      <nav aria-label={copy.nav.label}>
        {copy.nav.links.map((link) => <a href={link.href} aria-current={pathname === link.href ? "page" : undefined}>{link.label}</a>)}
        <a href="/download">{copy.common.download}</a>
      </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>(".mobile-menu");
  const summary = menu?.querySelector("summary");
  const closeMenu = () => {
    if (menu) menu.open = false;
  };
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu?.open) {
      closeMenu();
      summary?.focus();
    }
  });
  document.addEventListener("click", (event) => {
    if (event.target instanceof Node && !menu?.contains(event.target)) closeMenu();
  });
  matchMedia("(min-width: 840px)").addEventListener("change", closeMenu);
</script>
