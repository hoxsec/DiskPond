---
import ExpandIcon from "@lucide/astro/icons/expand";
import { copy } from "../content";
import AppScreenshot from "./app-screenshot.astro";

const images = ["vault", "comparison", "activity"] as const;
const text = copy.home.gallery;
---

<div class="product-gallery container" data-gallery>
  <div class="gallery-toolbar">
    <div class="gallery-tabs" aria-label={text.label}>
      {text.tabs.map((label, index) => <a id={`gallery-tab-${index}`} href={`#gallery-panel-${index}`} data-gallery-tab={index}>{label}</a>)}
    </div>
    <span class="gallery-label">{text.demo}</span>
    <button class="icon-button gallery-expand" aria-label={text.expand} data-gallery-expand hidden><ExpandIcon aria-hidden="true" /></button>
  </div>
  {images.map((image, index) => <div class="gallery-panel" id={`gallery-panel-${index}`} data-gallery-panel={index}>
    <AppScreenshot name={image} alt={text.alts[index] ?? "DiskPond"} sizes="(max-width: 760px) 92vw, 1080px" eager={index === 0} />
  </div>)}
  <div class="gallery-caption"><span class="status-mark" aria-hidden="true"></span>{text.caption}<span class="mono">DiskPond / Windows</span></div>
</div>

<script>
  const gallery = document.querySelector<HTMLElement>("[data-gallery]");
  const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-gallery-tab]"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-gallery-panel]"));
  gallery?.querySelector(".gallery-tabs")?.setAttribute("role", "tablist");
  const select = (index: number, focus = false) => {
    tabs.forEach((tab, current) => {
      tab.setAttribute("role", "tab");
      tab.setAttribute("aria-selected", String(current === index));
      tab.setAttribute("aria-controls", `gallery-panel-${current}`);
      tab.tabIndex = current === index ? 0 : -1;
    });
    panels.forEach((panel, current) => {
      panel.hidden = current !== index;
      panel.setAttribute("role", "tabpanel");
      panel.setAttribute("aria-labelledby", `gallery-tab-${current}`);
      panel.tabIndex = 0;
    });
    if (focus) tabs[index]?.focus();
  };
  tabs.forEach((tab, index) => {
    tab.href = `#gallery-panel-${index}`;
    tab.addEventListener("click", (event) => { event.preventDefault(); select(index); });
    tab.addEventListener("keydown", (event) => {
      let next = index;
      if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
      else if (event.key === "ArrowLeft") next = (index - 1 + tabs.length) % tabs.length;
      else if (event.key === "Home") next = 0;
      else if (event.key === "End") next = tabs.length - 1;
      else return;
      event.preventDefault();
      select(next, true);
    });
  });
  select(0);
</script>
