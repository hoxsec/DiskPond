---
import ArrowUpRightIcon from "@lucide/astro/icons/arrow-up-right";
import Building2Icon from "@lucide/astro/icons/building-2";
import CheckIcon from "@lucide/astro/icons/check";
import CloudIcon from "@lucide/astro/icons/cloud";
import HardDriveIcon from "@lucide/astro/icons/hard-drive";
import { cloudPrice, emailLink, euro, site } from "../config";
import { copy } from "../content";

const periods = (["monthly", "yearly"] as const).map((period) => {
  const price = cloudPrice(period);
  const billing = `${euro(price.totalCents)} ${copy.pricing[period]}. ${copy.common.vat}.`;
  return {
    period,
    price,
    billing,
    href: emailLink(
      site.salesEmail,
      `${copy.pricing.personal.subject} (${copy.pricing[period]})`,
      `${copy.pricing.personal.enquiry}\n\n${billing}`,
    ),
  };
});
---
<section class="section container pricing-section" id="plans">
  <div class="section-heading centered">
    <p class="eyebrow">{copy.pricing.eyebrow}</p><h2>{copy.pricing.title}</h2><p>{copy.pricing.description}</p>
  </div>
  <fieldset class="billing-toggle" data-billing-toggle hidden>
    <legend class="sr-only">{copy.pricing.billing}</legend>
    <label><input type="radio" name="billing" value="monthly" checked /><span>{copy.pricing.monthly}</span></label>
    <label><input type="radio" name="billing" value="yearly" /><span>{copy.pricing.yearly}<small>{copy.pricing.save}</small></span></label>
  </fieldset>
  <div class="pricing-grid">
    <article class="plan-card">
      <HardDriveIcon class="plan-icon" aria-hidden="true" />
      <h3>{copy.pricing.free.name}</h3><p>{copy.pricing.free.description}</p>
      <div class="plan-price"><strong>{copy.common.free}</strong></div><p class="billing-note">{copy.pricing.free.priceNote}</p>
      <a class="button button-secondary" href="/download">{copy.common.download}<ArrowUpRightIcon aria-hidden="true" /></a>
      <ul class="check-list">{copy.pricing.free.features.map((feature) => <li><CheckIcon aria-hidden="true" />{feature}</li>)}</ul>
      <p class="small plan-footnote">{copy.pricing.free.note}</p>
    </article>
    <article class="plan-card featured-plan">
      <div class="plan-top"><CloudIcon class="plan-icon" aria-hidden="true" /><span class="badge">{copy.common.comingSoon}</span></div>
      <h3>{copy.pricing.personal.name}</h3><p>{copy.pricing.personal.description}</p>
      <div aria-live="polite" aria-atomic="true">
        {periods.map(({ period, price }) => <div data-price-period={period} hidden={period !== "monthly"}><div class="plan-price"><strong>{euro(price.monthlyCents)}</strong><span>{copy.common.perMonth}</span></div><p class="billing-note">{period === "yearly" ? `${euro(price.totalCents)} · ${copy.pricing.annualBilling}` : copy.pricing.monthlyBilling}</p></div>)}
      </div>
      {periods.map(({ period, href }) => <a class="button" data-enquiry-period={period} hidden={period !== "monthly"} href={href}>{copy.pricing.personal.cta}<ArrowUpRightIcon aria-hidden="true" /></a>)}
      <ul class="check-list">{copy.pricing.personal.features.map((feature) => <li><CheckIcon aria-hidden="true" />{feature}</li>)}</ul>
      <p class="small plan-footnote">{copy.pricing.annualFallback}</p>
    </article>
    <article class="plan-card">
      <Building2Icon class="plan-icon" aria-hidden="true" />
      <h3>{copy.pricing.enterprise.name}</h3><p>{copy.pricing.enterprise.description}</p>
      <div class="plan-price"><strong>{copy.pricing.enterprise.price}</strong></div><p class="billing-note">{copy.pricing.enterprise.priceNote}</p>
      <a class="button button-secondary" href={emailLink(site.salesEmail, copy.pricing.enterprise.subject)}>{copy.pricing.enterprise.cta}<ArrowUpRightIcon aria-hidden="true" /></a>
      <ul class="check-list">{copy.pricing.enterprise.features.map((feature) => <li><CheckIcon aria-hidden="true" />{feature}</li>)}</ul>
    </article>
  </div>
  <p class="pricing-note">{copy.pricing.note}</p>
</section>

<script>
  document.querySelectorAll<HTMLElement>(".pricing-section").forEach((section) => {
    const toggle = section.querySelector<HTMLFieldSetElement>("[data-billing-toggle]");
    if (toggle) toggle.hidden = false;
    const update = () => {
      const period = section.querySelector<HTMLInputElement>("input[name=billing]:checked")?.value;
      section.querySelectorAll<HTMLElement>("[data-price-period]").forEach((element) => { element.hidden = element.dataset.pricePeriod !== period; });
      section.querySelectorAll<HTMLAnchorElement>("[data-enquiry-period]").forEach((element) => { element.hidden = element.dataset.enquiryPeriod !== period; });
    };
    toggle?.addEventListener("change", update);
    update();
  });
</script>
