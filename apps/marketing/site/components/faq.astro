---
import PlusIcon from "@lucide/astro/icons/plus";
import { copy } from "../content";

interface Props {
  items?: { question: string; answer: string }[];
}
const { items = copy.faq.app } = Astro.props;
---
<section class="section container faq-section">
  <div class="section-heading">
    <p class="eyebrow">{copy.faq.eyebrow}</p>
    <h2>{copy.faq.title}</h2>
    <p>{copy.faq.contact} <a class="text-link" href="/contact">{copy.faq.contactLink} ↗</a></p>
  </div>
  <div class="faq-list">
    {items.map((item) => <details class="faq-item"><summary>{item.question}<PlusIcon aria-hidden="true" /></summary><p>{item.answer}</p></details>)}
  </div>
</section>
