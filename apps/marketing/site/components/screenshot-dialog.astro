---
import XIcon from "@lucide/astro/icons/x";
import { copy } from "../content";
---

<dialog class="screenshot-dialog" aria-label={copy.home.gallery.label}>
  <div class="dialog-toolbar"><span>{copy.home.gallery.label}</span><form method="dialog"><button class="icon-button" aria-label={copy.home.gallery.close}><XIcon aria-hidden="true" /></button></form></div>
  <img width="1440" height="960" alt="" />
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(".screenshot-dialog");
  let trigger: HTMLElement | null = null;
  let scope: Element | null = null;
  const updateImage = () => {
    const source = Array.from(scope?.querySelectorAll<HTMLImageElement>("img[data-screenshot-theme]") ?? []).find(image => image.getClientRects().length > 0);
    const target = dialog?.querySelector("img");
    if (!source || !target) return;
    target.src = source.dataset.fullSrc || source.currentSrc || source.src;
    target.alt = source.alt;
    target.width = Number(source.getAttribute("width"));
    target.height = Number(source.getAttribute("height"));
    if (dialog) dialog.style.width = `min(${target.width}px, 95vw)`;
  };
  const open = (element: Element | null, button: HTMLElement) => {
    if (!element || !dialog) return;
    scope = element;
    trigger = button;
    updateImage();
    dialog.showModal();
  };
  document.querySelectorAll<HTMLAnchorElement>("[data-screenshot-open]").forEach(link => {
    link.addEventListener("click", event => {
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      open(link, link);
    });
  });
  document.querySelectorAll<HTMLButtonElement>("[data-gallery-expand]").forEach(button => {
    button.hidden = false;
    button.addEventListener("click", () => open(document.querySelector("[data-gallery-panel]:not([hidden])"), button));
  });
  new MutationObserver(() => { if (dialog?.open) updateImage(); }).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
  dialog?.addEventListener("click", event => {
    if (event.target !== dialog) return;
    const rect = dialog.getBoundingClientRect();
    if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close();
  });
  dialog?.addEventListener("close", () => { trigger?.focus(); scope = null; });
</script>
