---
import ArrowUpRightIcon from "@lucide/astro/icons/arrow-up-right";
import DownloadIcon from "@lucide/astro/icons/download";
import { copy } from "../content";
---
<section class="container cta-section">
  <div><p class="eyebrow">{copy.cta.eyebrow}</p><h2>{copy.cta.title}</h2><p>{copy.cta.description}</p></div>
  <div class="actions"><a class="button" href="/download"><DownloadIcon aria-hidden="true" />{copy.common.windowsDownload}</a><a class="text-link" href="/cloud">{copy.common.exploreCloud}<ArrowUpRightIcon aria-hidden="true" /></a></div>
</section>
