{
  "name": "diskpond",
  "private": true,
  "scripts": {
    "build": "pnpm build:desktop",
    "dev": "pnpm dev:desktop",
    "dev:desktop": "node scripts/desktop.mjs dev",
    "build:core": "node scripts/build-core.mjs",
    "build:branding": "node scripts/build-branding.mjs",
    "build:desktop": "node scripts/desktop.mjs build",
    "build:windows": "node scripts/desktop.mjs windows",
    "build:linux": "node scripts/desktop.mjs linux",
    "build:macos": "node scripts/desktop.mjs macos",
    "preview:desktop": "node scripts/desktop.mjs preview",
    "types:desktop": "pnpm --filter @diskpond/desktop --filter @diskpond/electron --filter \"./libs/*\" --if-present -r types",
    "test:desktop": "pnpm --filter @diskpond/desktop --filter @diskpond/electron --filter @diskpond/schemas --filter @diskpond/utils --no-bail -r test",
    "smoke:desktop": "node scripts/smoke-desktop.mjs",
    "smoke:discovery": "node scripts/smoke-discovery.mjs",
    "smoke:vaults": "node scripts/smoke-vault-flows.mjs",
    "smoke:restores": "node scripts/smoke-restores.mjs",
    "smoke:recovery": "node scripts/smoke-recovery.mjs",
    "smoke:passwords": "node scripts/smoke-password-storage.mjs",
    "smoke:providers": "node scripts/smoke-provider-storage.mjs",
    "smoke:windows": "node scripts/smoke-installed.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "format": "biome format --write .",
    "types": "pnpm types:desktop",
    "test": "pnpm test:desktop",
    "unused": "knip",
    "lint": "biome check .",
    "lint:ci": "biome ci . --error-on-warnings"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@biomejs/biome": "catalog:",
    "knip": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.14.0"
  }
}
